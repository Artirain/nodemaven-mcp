# Dashboard -> Profile -> API Key. Needed for location and usage tools.
NODEMAVEN_API_KEY=

# Dashboard -> Proxy Setup. Needed for check_proxy and fetch tools.
NODEMAVEN_PROXY_USERNAME=
NODEMAVEN_PROXY_PASSWORD=

# Optional overrides.
NODEMAVEN_PROXY_HOST=gate.nodemaven.com
NODEMAVEN_HTTP_PORT=8080
NODEMAVEN_SOCKS5_PORT=1080
NODEMAVEN_API_BASE_URL=https://api.nodemaven.com/api/v2
